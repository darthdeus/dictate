# ------------------------------------------------------------------ scoring


# Spelled-out numbers score like digits ("eighteen" == "18", "ten percent" == "10%").
NUMBER_WORDS = {w: str(i) for i, w in enumerate(
    "zero one two three four five six seven eight nine ten eleven twelve thirteen fourteen "
    "fifteen sixteen seventeen eighteen nineteen twenty".split())}
NUMBER_WORDS.update({w: str(10 * i) for i, w in enumerate("thirty forty fifty sixty seventy eighty ninety".split(), 3)})


def words(text):
    text = text.lower().replace("-", " ").replace("’", "'").replace("%", " percent")
    return [NUMBER_WORDS.get(w, w) for w in re.findall(r"[a-z0-9]+(?:[.'][a-z0-9]+)*", text)]


def edit_distance(ref, hyp):
    prev = list(range(len(hyp) + 1))
    for i, r in enumerate(ref, 1):
        cur = [i]
        for j, h in enumerate(hyp, 1):
            cur.append(min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (r != h)))
        prev = cur
    return prev[-1]


# DICTBENCH_SCORE_TERMS: score glossary hits against a fixed list, so runs
# with different DICTATE_TERMS stay comparable.
SCORE_TERMS = [t.strip() for t in os.environ.get("DICTBENCH_SCORE_TERMS", "").split(",") if t.strip()] or TERMS


def term_hits(ref, hyp):
    """Glossary terms present in the reference, and how many the hypothesis kept."""
    rn, hn = " ".join(words(ref)), " ".join(words(hyp))
    found = [t for t in SCORE_TERMS if f" {' '.join(words(t))} " in f" {rn} "]
    hit = [t for t in found if f" {' '.join(words(t))} " in f" {hn} "]
    return len(hit), len(found), [t for t in found if t not in hit]

# ------------------------------------------------------------------ record


def record(args):
    mic = CFG.get("DICTATE_MIC") or "@DEFAULT_SOURCE@"
    channels, chan = int(CFG.get("DICTATE_CHANNELS", 1)), int(CFG.get("DICTATE_CHAN", 0))
    session = (Path(args.session) if "/" in args.session else STATE / args.session) if args.session \
        else STATE / datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
    session.mkdir(parents=True, exist_ok=True)
    # A session keeps its own copy of the sentence list, so later batches
    # (--next) need no DICTBENCH_SENTENCES and keep the same numbering.
    saved = session / "sentences.txt"
    if not saved.exists():
        saved.write_text(Path(os.environ.get("DICTBENCH_SENTENCES", HERE / "sentences.txt" if (HERE / "sentences.txt").exists() else HERE / "sentences.example.txt")).read_text())
    sentences = [l.strip() for l in saved.read_text().splitlines() if l.strip() and not l.startswith("#")]
    only = {int(n) for n in args.only.split(",")} if args.only else None
    if args.next:
        only = set([n for n in range(1, len(sentences) + 1) if not (session / f"{n:02d}.wav").exists()][:args.next])
    done = lambda: sum((session / f"{n:02d}.wav").exists() for n in range(1, len(sentences) + 1))
    print(f"Session: {session}\nMic: {mic} (channel {chan} of {channels})\n"
          f"Recorded so far: {done()}/{len(sentences)}\n"
          "Enter starts, Enter stops. 's' skips, 'q' quits.\n")
    for n, text in enumerate(sentences, 1):
        if only is not None and n not in only:
            continue
        print(f"[{n}/{len(sentences)}] {text}")
        answer = input("  ready? ").strip().lower()
        if answer == "q":
            break
        if answer == "s":
            continue
        raw = session / f"{n:02d}.raw"
        rec = subprocess.Popen(["pw-record", "--target", mic, "--rate", "48000", "--channels", str(channels),
                                "--format", "s16", "--container", "raw", str(raw)], stderr=subprocess.DEVNULL)
        input("  recording... ")
        time.sleep(0.25)  # don't clip the last word on a quick Enter
        rec.send_signal(signal.SIGINT)
        rec.wait()
        subprocess.run(["ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "error", "-f", "s16le",
                        "-ar", "48000", "-ac", str(channels), "-i", str(raw), "-af", f"pan=mono|c0=c{chan}",
                        "-ar", "16000", "-ac", "1", "-c:a", "pcm_s16le", "-y", str(session / f"{n:02d}.wav")],
                       check=True)
        raw.unlink()
        (session / f"{n:02d}.txt").write_text(text + "\n")
    print(f"\nRecorded {done()}/{len(sentences)}. Next batch: dictbench record --session {session.name} --next 10"
          f"\nScore: dictbench run {session.name}")

# ------------------------------------------------------------------ run


def run(args):
    if args.session:
        session = Path(args.session) if "/" in args.session else STATE / args.session
    else:
        session = max((p for p in STATE.iterdir() if p.is_dir()), key=lambda p: p.name)
    clips = sorted(session.glob("*.wav"))
    if not clips:
        sys.exit(f"no clips in {session}")
    names = args.providers.split(",") if args.providers else list(PROVIDERS)
    spec = {n: resolve(n) for n in names}
    active = [n for n in names if (spec[n][1] is None or KEYS.get(spec[n][1]))
              and ("+" not in n or KEYS.get("GROQ_API_KEY"))]
    skipped = [n for n in names if n not in active]
    print(f"Session {session.name}: {len(clips)} clips; providers: {', '.join(active)}"
          + (f" (no key: {', '.join(skipped)})" if skipped else ""))

    results = {n: [] for n in active}
    for clip in clips:
        ref = clip.with_suffix(".txt").read_text().strip()
        print(f"  {clip.stem}: ", end="", flush=True)
        for name in active:
            fn = spec[name][0]
            t0 = time.perf_counter()
            try:
                out = fn(clip)
                hyp, lat = out if isinstance(out, tuple) else (out, time.perf_counter() - t0)
                err = None
            except Exception as e:  # keep going; one flaky provider shouldn't sink the run
                hyp, lat, err = "", None, str(e)
            hyp = hyp.strip()
            rw, hw = words(ref), words(hyp)
            hits, found, missed = term_hits(ref, hyp)
            results[name].append({"clip": clip.stem, "ref": ref, "hyp": hyp, "latency": lat, "error": err,
                                  "edits": edit_distance(rw, hw), "ref_words": len(rw),
                                  "term_hits": hits, "terms": found, "missed": missed})
            print("x" if err else ".", end="", flush=True)
        print()

    rows = []
    for name, rs in results.items():
        edits = sum(r["edits"] for r in rs)
        total = sum(r["ref_words"] for r in rs)
        lats = [r["latency"] for r in rs if r["latency"] is not None]
        rows.append({"provider": name, "wer": edits / total if total else 0,
                     "terms": f"{sum(r['term_hits'] for r in rs)}/{sum(r['terms'] for r in rs)}",
                     "perfect": sum(r["edits"] == 0 for r in rs),
                     "lat_med": statistics.median(lats) if lats else None,
                     "lat_max": max(lats) if lats else None,
                     "errors": sum(r["error"] is not None for r in rs)})
    rows.sort(key=lambda r: r["wer"])

    def ms(v):
        return f"{v * 1000:.0f} ms" if v is not None else "-"

    table = ["| provider | WER | glossary terms | exact clips | latency median | latency max | errors |",
             "|---|---|---|---|---|---|---|"]
    table += [f"| {r['provider']} | {r['wer']:.1%} | {r['terms']} | {r['perfect']}/{len(clips)} | "
              f"{ms(r['lat_med'])} | {ms(r['lat_max'])} | {r['errors']} |" for r in rows]
    detail = []
    for i, clip in enumerate(clips):
        detail.append(f"\n### {clip.stem}\n\n**ref:** {results[active[0]][i]['ref']}\n")
        for name in active:
            r = results[name][i]
            mark = "ok" if r["edits"] == 0 else f"{r['edits']} err"
            extra = f" — missed: {', '.join(r['missed'])}" if r["missed"] else ""
            body = f"ERROR {r['error']}" if r["error"] else r["hyp"]
            detail.append(f"- **{name}** ({mark}, {ms(r['latency'])}{extra}): {body}")

    stamp = datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
    out = session / f"report-{stamp}"
    (out.with_suffix(".json")).write_text(json.dumps({"summary": rows, "results": results}, indent=2))
    (out.with_suffix(".md")).write_text(f"# dictbench {session.name}\n\n" + "\n".join(table)
                                        + "\n\n## Per clip\n" + "\n".join(detail) + "\n")
    print("\n" + "\n".join(table) + f"\n\nFull report: {out.with_suffix('.md')}")
    for label, s in TCPP_STATS.items():
        cold = f"{s['cold_s']:.1f} s" if s["cold_s"] is not None else "-"
        print(f"transcribe.cpp {label}: cold first clip {cold} (load + shader compile), peak VRAM {s['vram_mib']} MiB")
    if POST_REJECTED:
        print("LLM outputs rejected (bad JSON or changing too much):", POST_REJECTED)
    if POST_BADJSON:
        print("LLM answers that were not fixes JSON:", POST_BADJSON, LLM_RAW)
    llm = {}
    for m, ts in LLM_TIMES.items():
        toks, itoks = LLM_TOKENS.get(m, []), LLM_IN_TOKENS.get(m, [])
        p90 = sorted(ts)[min(len(ts) - 1, int(0.9 * len(ts)))]
        llm[m] = {"times": ts, "out_tokens": toks, "in_tokens": itoks,
                  "rejected": POST_REJECTED.get(m, 0), "bad_json": POST_BADJSON.get(m, 0)}
        print(f"LLM {m}: request median {statistics.median(ts)*1000:.0f} ms, p90 {p90*1000:.0f} ms, "
              f"max {max(ts)*1000:.0f} ms, tokens in/out median {statistics.median(itoks):.0f}/"
              f"{statistics.median(toks):.0f}")
    if llm:
        d = json.loads(out.with_suffix(".json").read_text())
        d["llm"] = llm
        out.with_suffix(".json").write_text(json.dumps(d, indent=2))


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("record")
    r.add_argument("--only", help="comma-separated sentence numbers to (re)record")
    r.add_argument("--session", help="existing session dir to add takes to")
    r.add_argument("--next", type=int, metavar="N", help="record the next N sentences not yet recorded in --session")
    u = sub.add_parser("run")
    u.add_argument("session", nargs="?")
    u.add_argument("-p", "--providers", help=f"comma-separated subset of: {','.join(PROVIDERS)}")
    sub.add_parser("providers")
    a = ap.parse_args()
    if a.cmd == "record":
        record(a)
    elif a.cmd == "run":
        run(a)
    else:
        for name, (_, key, desc) in PROVIDERS.items():
            ok = "ready" if key is None or KEYS.get(key) else f"needs {key}"
            print(f"{name:16} {ok:28} {desc}")


if __name__ == "__main__":
    main()
