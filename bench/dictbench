def load_keys():
    keys = {}
    f = Path.home() / ".config/dictate/keys.env"
    if f.exists():
        for line in f.read_text().splitlines():
            if "=" in line and not line.lstrip().startswith("#"):
                k, v = line.split("=", 1)
                keys[k.strip()] = v.strip().strip("'\"")
    keys.update({k: v for k, v in os.environ.items() if k.endswith("_API_KEY")})
    if "DEEPGRAM_API_KEY" not in keys:
        try:
            w = tomllib.loads((Path.home() / ".config/whisrs/config.toml").read_text())
            if w.get("deepgram", {}).get("api_key"):
                keys["DEEPGRAM_API_KEY"] = w["deepgram"]["api_key"]
        except OSError:
            pass
    return keys


