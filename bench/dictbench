TCPP_CACHE = {}


def tcpp_batch(model, vocab):
    def fn(wav):
        key = (model, vocab, wav.parent)
        if key not in TCPP_CACHE:
            wavs = sorted(wav.parent.glob("*.wav"))
            lst = wav.parent / f".batch-{os.getpid()}.txt"
            lst.write_text("".join(f"{w}\n" for w in wavs))
            cmd = [str(TCPP), "-m", str(TMODELS / model), "--backend", "vulkan", "--batch", str(lst)]
            if vocab:
                cmd += ["--vocabulary", ",".join(TERMS)]
            out = subprocess.run(cmd, capture_output=True, text=True, timeout=1800).stdout
            lst.unlink()
            texts, cur = {}, None
            for line in out.splitlines():
                m = re.match(r"\[\d+/\d+\] (.+\.wav)$", line)
                if m:
                    cur = m.group(1)
                elif line.startswith("  text: ") and cur:
                    texts[cur] = line[len("  text: "):]
            TCPP_CACHE[key] = texts
        return TCPP_CACHE[key].get(str(wav), ""), None
    return fn


# Warm offline models (NVIDIA Parakeet / Canary). One transcribe-cli process per
# session with --batch-jsonl; the first clip is run twice and the first pass is
# thrown away (load + Vulkan shader compile), so each clip's latency is the wall
# time between consecutive output lines: what a resident model would cost.
# VRAM is the process's peak from nvidia-smi. Boost builds come from the
# phrase-boost worktree; with an empty vocabulary they match upstream exactly.
TCPP_BOOST = Path(os.environ.get("TRANSCRIBE_CLI_BOOST",
                                 Path.home() / "projects/transcribe.cpp-boost/build-boost/bin/transcribe-cli"))
# Glossary minus short or everyday words, which phrase boosting turns into
# collateral substitutions (AI, master, diff, prompt...).
TRIM_DROP = {"rock", "stone", "unicorn", "blender", "markdown", "master", "ai", "uv", "gpu", "cli", "sdk", "gpt",
             "json", "yaml", "opus", "sonnet", "sol", "astra", "worker", "prompt", "arc", "diff", "cull", "culling",
             "luna", "deny list"}
TERMS_TRIM = [t for t in TERMS if t.lower() not in TRIM_DROP]
TCPP_WARM_CACHE = {}
TCPP_STATS = {}  # label -> {"cold_s", "vram_mib"}


def _gpu_mem(pid):
    try:
        out = subprocess.run(["nvidia-smi", "--query-compute-apps=pid,used_memory", "--format=csv,noheader,nounits"],
                             capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return 0
    for line in out.splitlines():
        p, _, mem = line.partition(",")
        if p.strip() == str(pid):
            return int(mem.strip() or 0)
    return 0


def tcpp_warm(label, model, terms=None, boost=None, extra=()):
    def fn(wav):
        key = (label, wav.parent)
        if key not in TCPP_WARM_CACHE:
            import threading
            wavs = sorted(wav.parent.glob("*.wav"))
            lst = wav.parent / f".batch-{os.getpid()}.txt"
            lst.write_text("".join(f"{w}\n" for w in [wavs[0]] + wavs))
            cmd = [str(TCPP_BOOST), "-q", "-m", str(TMODELS / model), "--backend", "vulkan", "-l", LANG,
                   "--batch", str(lst), "--batch-jsonl", *extra]
            if terms:
                cmd += ["--vocabulary", ",".join(terms)]
            env = dict(os.environ)
            if boost is not None:
                env["TRANSCRIBE_PARAKEET_VOCAB_BOOST"] = str(boost)
            t0 = time.perf_counter()
            proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, env=env)
            peak = [0]

            def poll():
                while proc.poll() is None:
                    peak[0] = max(peak[0], _gpu_mem(proc.pid))
                    time.sleep(0.2)
            threading.Thread(target=poll, daemon=True).start()
            rows, last = [], None
            for line in proc.stdout:
                if not line.startswith('{"file"'):
                    continue
                now = time.perf_counter()
                rows.append((json.loads(line), now - (last if last is not None else t0)))
                last = now
            proc.wait()
            lst.unlink()
            TCPP_STATS[label] = {"cold_s": rows[0][1] if rows else None, "vram_mib": peak[0]}
            TCPP_WARM_CACHE[key] = {r["file"]: (r.get("text", ""), dt) for r, dt in rows[1:]}
        return TCPP_WARM_CACHE[key].get(str(wav), ("", None))
    return fn


