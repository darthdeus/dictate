# ------------------------------------------------------------------ providers
# Each returns the transcript text; the caller times it.


def whisper_local(wav):
    server = os.environ.get("DICTATE_SERVER", "http://127.0.0.1:8127")
    with open(wav, "rb") as f:
        r = requests.post(f"{server}/inference", files={"file": f}, timeout=120, data={
            "response_format": "json", "language": LANG, "prompt": PROMPT, "temperature": "0.0"})
    r.raise_for_status()
    return r.json()["text"]


def openai_style(url, key, model, wav, prompt=True):
    data = {"model": model, "language": LANG, "response_format": "json", "temperature": "0"}
    if prompt:
        data["prompt"] = PROMPT
    with open(wav, "rb") as f:
        r = requests.post(url, headers={"Authorization": f"Bearer {key}"}, timeout=120,
                          files={"file": ("audio.wav", f, "audio/wav")}, data=data)
    if not r.ok:
        raise RuntimeError(f"{r.status_code}: {r.text[:200]}")
    return r.json()["text"]


def groq(wav):
    return openai_style("https://api.groq.com/openai/v1/audio/transcriptions",
                        KEYS["GROQ_API_KEY"], "whisper-large-v3-turbo", wav)


def openai_4o(wav):
    return openai_style("https://api.openai.com/v1/audio/transcriptions",
                        KEYS["OPENAI_API_KEY"], os.environ.get("OPENAI_STT_MODEL", "gpt-4o-transcribe"), wav)


def deepgram_params(**extra):
    params = [("model", "nova-3"), ("language", LANG), ("smart_format", "true"), ("punctuate", "true")]
    params += [("keyterm", t) for t in TERMS]
    params += list(extra.items())
    return urlencode(params)


def deepgram(wav):
    r = requests.post(f"https://api.deepgram.com/v1/listen?{deepgram_params()}", timeout=120,
                      headers={"Authorization": f"Token {KEYS['DEEPGRAM_API_KEY']}",
                               "Content-Type": "audio/wav"}, data=Path(wav).read_bytes())
    if not r.ok:
        raise RuntimeError(f"{r.status_code}: {r.text[:200]}")
    return r.json()["results"]["channels"][0]["alternatives"][0]["transcript"]


def elevenlabs(wav):
    model = os.environ.get("ELEVENLABS_STT_MODEL", "scribe_v2")
    with open(wav, "rb") as f:
        r = requests.post("https://api.elevenlabs.io/v1/speech-to-text", timeout=120,
                          headers={"xi-api-key": KEYS["ELEVENLABS_API_KEY"]},
                          files={"file": ("audio.wav", f, "audio/wav")},
                          data=[("model_id", model), ("language_code", LANG), ("tag_audio_events", "false")]
                          + [("keyterms", t) for t in TERMS[:100]])
    if not r.ok:
        raise RuntimeError(f"{r.status_code}: {r.text[:200]}")
    return r.json()["text"]


async def _deepgram_stream(wav):
    import websockets
    with wave.open(str(wav)) as w:
        rate, pcm = w.getframerate(), w.readframes(w.getnframes())
    chunk = rate * 2 // 10  # 100 ms of s16 mono
    url = "wss://api.deepgram.com/v1/listen?" + deepgram_params(
        encoding="linear16", sample_rate=str(rate), channels="1")
    finals, t_end = [], None
    async with websockets.connect(url, additional_headers={
            "Authorization": f"Token {KEYS['DEEPGRAM_API_KEY']}"}) as ws:
        async def send():
            nonlocal t_end
            for i in range(0, len(pcm), chunk):
                await ws.send(pcm[i:i + chunk])
                await asyncio.sleep(0.1)
            t_end = time.perf_counter()
            await ws.send(json.dumps({"type": "CloseStream"}))
        sender = asyncio.create_task(send())
        async for msg in ws:
            m = json.loads(msg)
            if m.get("type") == "Results" and m.get("is_final"):
                text = m["channel"]["alternatives"][0]["transcript"]
                if text:
                    finals.append(text)
        await sender
    return " ".join(finals), time.perf_counter() - t_end


def deepgram_stream(wav):
    return asyncio.run(_deepgram_stream(wav))


